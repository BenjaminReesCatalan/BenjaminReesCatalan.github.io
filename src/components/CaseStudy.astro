---
interface Props {
  category: string;
  number: string;
  title: string;
  description: string;
  rol: string;
  year: string;
  focus: string[];
  painTitle: string;
  painText: string;
  processTitle: string;
  processText: string;
  solutionTitle: string;
  solutionText: string;
  galleryTitle?: string;
  coverImage?: string;
  prevProject?: { slug: string; name: string; category: string };
  nextProject?: { slug: string; name: string; category: string };
}

const {
  category,
  number,
  title,
  description,
  rol,
  year,
  focus,
  painTitle,
  painText,
  processTitle,
  processText,
  solutionTitle,
  solutionText,
  galleryTitle = "Galería de imágenes",
  coverImage,
  prevProject,
  nextProject,
} = Astro.props;
---

<article class="case-study">
  <header class="case-header section">
    <div class="container">
      <div class="case-header-content">
        <div class="case-header-text">
          <span class="case-category">{number} - {category}</span>
          <h1 class="case-title">{title}</h1>
          <p class="case-description">{description}</p>
        </div>
        {coverImage && (
          <div class="case-cover">
            <img src={coverImage} alt={title} />
          </div>
        )}
      </div>

      <div class="case-meta">
        <div class="meta-item">
          <span class="meta-label">Rol</span>
          <span class="meta-value">{rol}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Año</span>
          <span class="meta-value">{year}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Enfoque</span>
          <span class="meta-value">{focus.join(" • ")}</span>
        </div>
      </div>
    </div>
  </header>

  <section class="case-content section">
    <div class="container">
      <div class="content-grid">
        <div class="content-column">
          <span class="column-number">01</span>
          <h2 class="column-title">{painTitle}</h2>
          <div class="column-text" set:html={painText}></div>
        </div>

        <div class="content-column">
          <span class="column-number">02</span>
          <h2 class="column-title">{processTitle}</h2>
          <div class="column-text" set:html={processText}></div>
        </div>

        <div class="content-column">
          <span class="column-number">03</span>
          <h2 class="column-title">{solutionTitle}</h2>
          <div class="column-text" set:html={solutionText}></div>
        </div>
      </div>
    </div>
  </section>

  <section class="case-gallery section">
    <div class="container">
      <h2 class="gallery-title">{galleryTitle}</h2>
      <slot />
    </div>
  </section>

  <nav class="case-navigation">
    <div class="container">
      <div class="nav-links">
        {prevProject ? (
          <a href={prevProject.slug} class="nav-prev">
            <span class="nav-label">Proyecto anterior</span>
            <div class="nav-project-row">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
              <span class="nav-project">{prevProject.name} / {prevProject.category}</span>
            </div>
          </a>
        ) : <div></div>}

        {nextProject ? (
          <a href={nextProject.slug} class="nav-next">
            <span class="nav-label">Siguiente proyecto</span>
            <div class="nav-project-row">
              <span class="nav-project">{nextProject.name} / {nextProject.category}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ) : <div></div>}
      </div>
    </div>
  </nav>
</article>

<style>
  .case-header {
    padding-top: 120px;
    padding-bottom: 32px;
    background: #F8F9FC;
  }

  .case-header-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 40px;
  }

  .case-header-text {
    display: flex;
    flex-direction: column;
  }

  .case-cover img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .case-category {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
    display: block;
    margin-bottom: 16px;
  }

  .case-title {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
    max-width: 700px;
  }

  .case-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 40px;
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 32px;
    border-right: 1px solid var(--color-border);
  }

  .meta-item:first-child {
    padding-left: 0;
  }

  .meta-item:last-child {
    padding-right: 0;
    border-right: none;
  }

  .meta-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .meta-value {
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .case-content {
    background: #F8F9FC;
    padding: 32px 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .content-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 32px;
    border-right: 2px solid #F8F9FC;
  }

  .content-column:first-child {
    padding-left: 40px;
  }

  .content-column:last-child {
    padding-right: 40px;
    border-right: none;
  }

  .column-number {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .column-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .column-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .case-gallery {
    background: #F8F9FC;
    padding-top: 32px;
  }

  .gallery-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 32px;
  }

  .case-navigation {
    background: #F8F9FC;
    padding: 0 0 32px 0;
  }

  .nav-links {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: color 0.3s ease;
  }

  .nav-prev:hover,
  .nav-next:hover {
    color: var(--color-accent);
  }

  .nav-next {
    text-align: right;
  }

  .nav-project-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-next .nav-project-row {
    justify-content: flex-end;
  }

  .nav-label {
    font-size: 0.875rem;
    color: var(--color-primary);
  }

  .nav-project {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  .nav-prev:hover .nav-project,
  .nav-next:hover .nav-project {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .case-title {
      font-size: 2rem;
    }

    .case-meta {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .meta-item {
      padding: 0;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 16px;
    }

    .meta-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .content-column {
      padding: 24px;
      border-right: none;
      border-bottom: 2px solid #F8F9FC;
    }

    .content-column:last-child {
      border-bottom: none;
    }

    .nav-links {
      flex-direction: column;
      gap: 24px;
    }

    .nav-next {
      text-align: left;
    }
  }
</style>
